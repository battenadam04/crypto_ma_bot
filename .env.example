# Secrets only. All other settings are hardcoded in config.py.
TELEGRAM_TOKEN=
# Private Pro channel ID (signals post here). Forward a channel message to @userinfobot to get it.
TELEGRAM_CHAT_ID=
# Your Telegram numeric user ID(s), comma-separated. Only these users can /on /timeframe /live etc.
# Get yours from @userinfobot. Leave empty only for solo testing.
TELEGRAM_ADMIN_IDS=
# Boot with scanning on (default). Set false only if you want the feed off until /on.
# TRADING_ENABLED=true

# Phemex API credentials for live trading (optional; signals work without these).
# Generate at: https://phemex.com/account/api-management
PHEMEX_API_KEY=
PHEMEX_API_SECRET=
