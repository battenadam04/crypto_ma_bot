# Market-data exchange for OHLCV / pair discovery (public endpoints — no trading keys required).
# CCXT ids via EXCHANGE: phemex | binance_margin | kucoin | kucoin_futures
# - phemex → USDT perpetuals (symbols like BTC/USDT:USDT)
# - binance_margin → USDT spot-style symbols (BTC/USDT)
EXCHANGE=phemex

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional sandbox flags for market-data testing
PHEMEX_SANDBOX=false
BINANCE_SANDBOX=false

# Optional fallback only: live bot uses last_backtest.json pairs first; CRYPTO_PAIRS if missing.
CRYPTO_PAIRS=

MAIN_LOOP_INTERVAL_SEC=300

# Signal volume controls
# Don't re-alert the same symbol+direction within this many seconds (default 1h).
SIGNAL_COOLDOWN_SEC=3600
# Max Telegram alerts per scan cycle after ranking (0 = unlimited).
MAX_SIGNALS_PER_CYCLE=3
# Speculative LIM near-support/resistance ideas (noisier). Confirmed SIG alerts always prefer.
ENABLE_LIMIT_IDEA_FALLBACK=false

# Overnight pause: skip pair scanning in a daily window (Telegram still polls).
# After enabling, use /night on | /night off in Telegram (armed state saved in runtime_config.json).
NIGHT_QUIET_ENABLED=false
NIGHT_QUIET_START_HOUR=22
NIGHT_QUIET_END_HOUR=6
NIGHT_QUIET_TZ=UTC
NIGHT_QUIET_SLEEP_SEC=60
NIGHT_QUIET_ARMED_DEFAULT=true

# Signal timeframe (also changeable via Telegram /timeframe)
TIMEFRAME=5m

# Signal thresholds
MIN_ADX_TREND=0
RSI_OVERSOLD=35
RSI_OVERBOUGHT=65
RANGE_ADX_THRESHOLD=25
LIMIT_ENTRY_OFFSET_PCT=0.0015
LIMIT_IDEA_FALLBACK_PCT=0.003

# Backtest parameters (run: python strategies/simulate_trades.py)
BACKTEST_PAIRS=
BACKTEST_AUTO_TOP_PAIRS=false
BACKTEST_TOP_N=20
BACKTEST_MIN_QUOTE_VOLUME=1000000
BACKTEST_COINGECKO_MIN_CAP=1000000000
BACKTEST_INTERVAL_HOURS=168
BACKTEST_WIN_RATE_THRESHOLD=50
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_COMMISSION_BPS=4
BACKTEST_COOLDOWN_BARS=10
BACKTEST_LOOKAHEAD=50
BACKTEST_DAYS=28
BACKTEST_USE_LIMIT_IDEAS=false
BACKTEST_PER_PAIR_LIMIT_FALLBACK=false
BACKTEST_LIMIT_FILL_BARS=3
BACKTEST_MIN_RR_RATIO=2.0
BACKTEST_ENFORCE_RR=false
BACKTEST_APPLY_FEES=true
